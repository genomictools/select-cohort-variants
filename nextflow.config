
singularity {
    enabled = true
    autoMounts = true
}

params {
    // Containers
    bcftools      = 'bcftools.1.19'
    samtools      = 'samtools.1.9'
    bioconductor  = 'mahshaaban/bioconductor:3.19'
    rocker        = 'rocker/tidyverse:latest'
    rvs           = 'rvs.1.24.0'
    plink         = 'plink.1.9'
    
    // Default params
    genome        = 'hg38'
    style         = 'UCSC'
    GQ            = 10
    DP            = 5
    VAF           = 0.2
    MAF           = 0.5
    HWE           = 1e-5
    ExcHet        = 0.5
    AF            = 0.5
    DS            = 0.2
    CADD          = 5
    categories    = 'Pathogenic,Damaging,Splicing,High,PTV,Stop'
    coding        = 'true'
    normalize     = true
    pass          = true
    missing_as_ref= true
    fill          = true
    AF_COL        = 'gnomADe_AF'
    chunk         = 10000
}

profiles {
  // Resource profiles
  local     { includeConfig 'conf/local.config' }
  cluster   { includeConfig 'conf/cluster.config' }
  dynamic   { includeConfig 'conf/dynamic.config' }
  
  // Test profile (Same as default params)
  test {
    params {
      cohorts = "input/cohorts_input.csv"
    }
  }
}
